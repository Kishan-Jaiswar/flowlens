{
  "name": "flowslens-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "FlowLens - trace any user action from the UI to the database",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b packages/core packages/runtime packages/cli",
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc -b packages/core packages/runtime packages/cli --force",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run lint && npm run format:check && npm run test",
    "flowlens": "node bin/flowlens.mjs",
    "scan:example": "node bin/flowlens.mjs scan examples/crud",
    "flows:example": "node bin/flowlens.mjs flows examples/crud",
    "serve:example": "node bin/flowlens.mjs serve examples/crud",
    "prepare": "node scripts/prepare.mjs",
    "test:package": "node scripts/package-test.mjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.3.0",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=18.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kishan-Jaiswar/flowlens.git"
  },
  "bugs": {
    "url": "https://github.com/Kishan-Jaiswar/flowlens/issues"
  },
  "homepage": "https://github.com/Kishan-Jaiswar/flowlens#readme",
  "author": "Kishan Jaiswar",
  "license": "MIT"
}
