{
  "name": "flowslens-monorepo",
  "version": "1.1.2",
  "private": true,
  "description": "Flowslens - trace any user action from the UI to the database: static analysis and runtime tracing for React/Next, NestJS/Express, Prisma and Mongoose codebases.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b packages/core packages/runtime packages/cli",
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc -b packages/core packages/runtime packages/cli --force",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run lint && npm run format:check && npm run test",
    "flowlens": "node bin/flowlens.mjs",
    "scan:example": "node bin/flowlens.mjs scan examples/crud",
    "flows:example": "node bin/flowlens.mjs flows examples/crud",
    "serve:example": "node bin/flowlens.mjs serve examples/crud",
    "prepare": "node scripts/prepare.mjs",
    "test:package": "node scripts/package-test.mjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=18.18"
  },
  "author": "Kishan Jaiswar",
  "license": "MIT",
  "keywords": [
    "static-analysis",
    "developer-tools",
    "code-navigation",
    "impact-analysis",
    "data-lineage",
    "react",
    "nextjs",
    "nestjs",
    "express",
    "mongoose",
    "mongodb",
    "prisma",
    "typescript"
  ]
}
