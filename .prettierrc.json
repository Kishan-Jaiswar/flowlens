{
  "printWidth": 100,
  "singleQuote": true,
  "trailingComma": "all",
  "arrowParens": "always",
  "semi": true,
  "overrides": [
    {
      "files": ["*.md", "*.yml", "*.yaml"],
      "options": { "printWidth": 80 }
    },
    {
      "files": ["*.jsonc"],
      "options": { "parser": "json5", "quoteProps": "preserve" }
    }
  ]
}
