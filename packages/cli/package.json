{
  "name": "@flowslens/cli",
  "version": "1.4.0",
  "description": "Trace any user action from the UI to the database. Maps every click through React/Next.js, NestJS/Express, Prisma, Mongoose and the MongoDB driver, flowcharts its decisions, explains the database schema in plain words, shows what a change breaks, finds dead code, and serves a local dashboard.",
  "type": "module",
  "bin": {
    "flowlens": "bin/flowlens.mjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "bin",
    "dashboard",
    "runtime"
  ],
  "scripts": {
    "build": "tsc -b",
    "prepack": "node ../../scripts/prepack.mjs"
  },
  "dependencies": {
    "@flowslens/core": "1.4.0"
  },
  "engines": {
    "node": ">=18.18"
  },
