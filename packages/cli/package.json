{
  "name": "@flowslens/cli",
  "version": "1.1.1",
  "description": "Trace any user action from the UI to the database. Maps React/Next + NestJS/Express + Prisma/Mongoose features, shows what a change would break, and serves a local dashboard.",
  "type": "module",
  "bin": {
    "flowlens": "bin/flowlens.mjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "bin",
    "dashboard",
    "runtime"
  ],
  "scripts": {
    "build": "tsc -b",
    "prepack": "node ../../scripts/prepack.mjs"
  },
  "dependencies": {
    "@flowslens/core": "1.1.1"
  },
  "engines": {
    "node": ">=18.18"
  },
  "license": "MIT",
  "author": "Kishan Jaiswar",
  "bugs": {
    "url": "https://github.com/Kishan-Jaiswar/flowlens/issues"
  },
  "homepage": "https://github.com/Kishan-Jaiswar/flowlens#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kishan-Jaiswar/flowlens.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "cli",
    "devtools",
    "developer-tools",
    "code-navigation",
    "codebase-onboarding",
    "static-analysis",
    "code-analysis",
    "impact-analysis",
    "blast-radius",
    "data-lineage",
    "dependency-graph",
    "call-graph",
    "legacy-code",
    "refactoring",
    "api-mapping",
    "dashboard",
    "react",
    "nextjs",
    "nestjs",
    "express",
    "mongoose",
    "mongodb",
    "prisma",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  }
}
