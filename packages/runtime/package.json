{
  "name": "@flowslens/runtime",
  "version": "1.3.1",
  "description": "Zero-dependency, development-only request tracer for Node.js, Next.js, Express, NestJS, Mongoose and the MongoDB driver: links a browser click to the API calls and database queries it caused, with per-step timings.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./browser": "./dist/browser.js",
    "./next": "./dist/next.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b"
  },
